PORT=5000

# Option A: managed Postgres connection string (Render, Neon, Railway, etc.)
DATABASE_URL=

# Option B: local / manual Postgres settings (used when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hostel_complaints
DB_USER=postgres
DB_PASSWORD=postgres

# Set DB_SSL=false only for local Postgres without SSL
# DB_SSL=false

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
SUPER_ADMIN_RESET_KEY=your-super-admin-reset-key-change-this

# Comma-separated allowed frontend origins for CORS (required in production)
# Example: https://your-app.vercel.app
FRONTEND_URL=
